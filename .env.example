# PORT (Optional, defaults to 3000 if not specified)
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SUPABASE INTEGRATION
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"


# GOOGLE OAUTH CREDENTIALS (Configure these in your Supabase Dashboard under Auth > Providers > Google)
# Google Client ID: your-google-client-id.apps.googleusercontent.com
# Google Client Secret: your-google-client-secret


